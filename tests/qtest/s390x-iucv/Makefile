# Guest programs of tests/qtest/s390x-iucv-test.c
#
# They are linked at 0x20000: QEMU treats -kernel images entered at
# 0x10000 as Linux and writes its parameter area there.
#
# The test embeds them from s390x-iucv-guests.h. After changing a program,
# run "make" here (on s390x, or with CROSS_PREFIX=s390x-linux-gnu-) and
# commit both the source and the header.

PROGS = cp regs smp unavailable tcpip tcpip2 net idle

.PHONY: all clean
all: ../s390x-iucv-guests.h

%.elf: %.S
	$(CROSS_PREFIX)gcc -nostdlib -static -Wl,-Ttext=0x20000 \
	 -Wl,--build-id=none -Wl,-zcommon-page-size=16 -Wl,-zmax-page-size=16 \
	 -o $@ $<
	$(CROSS_PREFIX)strip $@

../s390x-iucv-guests.h: $(PROGS:%=%.elf)
	echo "/* SPDX-License-Identifier: GPL-2.0-or-later */" > header.tmp
	echo "/* Generated by tests/qtest/s390x-iucv/Makefile: do not edit. */" >> header.tmp
	for p in $(PROGS); do \
	  xxd -i -n iucv_guest_$$p $$p.elf | sed -e 's/^unsigned/static const unsigned/' >> header.tmp; \
	done
	mv header.tmp $@

clean:
	rm -f *.elf header.tmp
